/*
Two Sensor Comparison

Pin A1 : Sensor 1  -  Pin 12 : LED 1  left
Pin A2 : Sensor 2  -  Pin 27 : LED 2  right

*/

//Sensor variables
int sensor1Pin = A1;
int sensor1Value;

int sensor2Pin = A2;
int sensor2Value;


int minimumValue1 = 900;   //Sensor 1 
int minimumValue2 = 1300;   //Sensor 2 more sensitive

//LED variables
int led1Pin = 12;
int led1Value;

int led2Pin = 27;
int led2Value;

//The brightness for a winning and a losing LED (0 - 255)
int onBrightness = 255;
int offBrightness = 0;

void setup()
{
  Serial.begin(9600);

  pinMode(led1Pin, OUTPUT);
  pinMode(led2Pin, OUTPUT);
}

void loop()
{
  //read both sensors (0 - 4095)
  sensor1Value = analogRead(sensor1Pin);
  sensor2Value = analogRead(sensor2Pin);


  bool sensor1Active = sensor1Value > minimumValue1;
  bool sensor2Active = sensor2Value > minimumValue2;

  //which LED wins
  if (!sensor1Active && !sensor2Active)
  {
    //neither sensor is active
    led1Value = offBrightness;
    led2Value = offBrightness;
  }
  else if (sensor1Active && (!sensor2Active || sensor1Value > sensor2Value))
  {
    //Sensor 1 is active and wins
    led1Value = onBrightness;
    led2Value = offBrightness;
  }
  else
  {
    //Sensor 2 is active and wins
    led1Value = offBrightness;
    led2Value = onBrightness;
  }

  //set the LEDs
  analogWrite(led1Pin, led1Value);
  analogWrite(led2Pin, led2Value);

  //print the sensor and LED values on one line
  Serial.print("Sensor 1: ");
  Serial.print(sensor1Value);
  Serial.print("   LED 1: ");
  Serial.print(led1Value);
  Serial.print("   Sensor 2: ");
  Serial.print(sensor2Value);
  Serial.print("   LED 2: ");
  Serial.println(led2Value);
}
